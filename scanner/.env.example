# Gere um token longo e aleatório e use o MESMO valor no processo PHP-FPM.
PM_SCANNER_TOKEN=SUBSTITUA_POR_UM_TOKEN_LONGO_E_ALEATORIO
SCANNER_HOST=127.0.0.1
SCANNER_PORT=8787
# Ajuste ao caminho real do Chromium no servidor:
CHROMIUM_PATH=/usr/bin/chromium
SCAN_TIMEOUT_MS=35000
MAX_CONCURRENT_SCANS=2
